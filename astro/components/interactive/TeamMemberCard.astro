---
import { Image } from 'astro:assets'
interface Props {
  name: string
  bio: string
  image: any
}

const { name, bio, image } = Astro.props
---

<div class="team-member" id={name} data-team-member={name}>
  <Image src={image} alt={`member: ${name}`} width={280} format="webp" loading="lazy" decoding="async" />
  <p class="sub1">{name}</p>
  <p>{bio}</p>
</div>
