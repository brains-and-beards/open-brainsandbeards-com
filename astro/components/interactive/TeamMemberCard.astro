---
import { Image } from 'astro:assets'
import ImagePriority from '../ui/ImagePriority.astro'
interface Props {
  name: string
  bio: string
  image: any
  priority?: boolean
}

const { name, bio, image, priority = false } = Astro.props
---

<div class="team-member" id={name} data-team-member={name}>
  <Image
    src={image}
    alt={`member: ${name}`}
    width={280}
    densities={[1, 2]}
    format="webp"
    loading="lazy"
    decoding="async"
  />
  {priority && <ImagePriority media="(min-width: 691px)" />}
  <p class="sub1">{name}</p>
  <p>{bio}</p>
</div>
