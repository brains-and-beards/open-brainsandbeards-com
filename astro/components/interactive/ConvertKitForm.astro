---
interface Props {
  formUrl?: string
  formId?: string
}

const { formUrl = 'https://brains-beards.ck.page/a54204fd58/index.js', formId = 'a54204fd58' } =
  Astro.props
---

<div
  class="convertkit-form"
  data-convertkit-form
  data-form-url={formUrl}
  data-form-id={formId}
></div>

<script>
  const loadForm = (container: HTMLElement) => {
    if (container.dataset.loaded === 'true') return
    const script = document.createElement('script')
    script.src = container.dataset.formUrl ?? ''
    script.async = true
    script.dataset.uid = container.dataset.formId ?? ''
    container.dataset.loaded = 'true'
    container.appendChild(script)
  }

  const containers = document.querySelectorAll<HTMLElement>('[data-convertkit-form]')

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return
          observer.unobserve(entry.target)
          loadForm(entry.target as HTMLElement)
        })
      },
      // Start fetching before the visitor reaches the form.
      { rootMargin: '300px 0px' }
    )
    containers.forEach(container => {
      if (container.dataset.loaded !== 'true') observer.observe(container)
    })
  } else {
    containers.forEach(loadForm)
  }
</script>
