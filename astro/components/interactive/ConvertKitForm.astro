---
interface Props {
  formUrl?: string
  formId?: string
}

const { formUrl = 'https://brains-beards.ck.page/a54204fd58/index.js', formId = 'a54204fd58' } =
  Astro.props
---

<div
  class="convertkit-form"
  data-convertkit-form
  data-form-url={formUrl}
  data-form-id={formId}
></div>

<script>
  document.querySelectorAll<HTMLElement>('[data-convertkit-form]').forEach(container => {
    if (container.dataset.loaded === 'true') return
    const script = document.createElement('script')
    script.src = container.dataset.formUrl ?? ''
    script.async = true
    script.dataset.uid = container.dataset.formId ?? ''
    container.dataset.loaded = 'true'
    container.appendChild(script)
  })
</script>
