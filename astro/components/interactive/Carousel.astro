---
export interface CarouselItem {
  id: string
  quote: string
  name: string
  position: string
  company: string
  imageUrl?: string
  imageAlt?: string
}

interface Props {
  label: string
  items: CarouselItem[]
}

const { label, items }: Props = Astro.props
---

<section class="astro-carousel" data-carousel aria-roledescription="carousel" aria-label={label}>
  <div class="astro-carousel__track" data-carousel-track tabindex="0">
    {items.map(({ id, quote, name, position, company, imageUrl, imageAlt }) => (
      <article
        class="astro-carousel__slide"
        id={id}
        aria-roledescription="slide"
        aria-label={`${name}, ${company}`}
      >
        <div class="astro-carousel__photo">
          <button
            class="astro-carousel__chevron astro-carousel__chevron--previous"
            type="button"
            data-carousel-prev
            aria-label="Previous reference"
          >
            <svg aria-hidden="true" viewBox="0 0 14 24">
              <path d="m13 0-12 12 12 12" />
            </svg>
          </button>
          {imageUrl && (
            <img
              class="astro-carousel__image"
              src={imageUrl}
              alt={imageAlt ?? ''}
              width="152"
              height="152"
              loading="lazy"
            />
          )}
          <button
            class="astro-carousel__chevron"
            type="button"
            data-carousel-next
            aria-label="Next reference"
          >
            <svg aria-hidden="true" viewBox="0 0 14 24">
              <path d="m1 0 12 12-12 12" />
            </svg>
          </button>
        </div>
        <p class="quote">{quote}</p>
        <p class="who">
          <b>{name}</b>,<br />
          {position},<br />
          {company}
        </p>
      </article>
    ))}
  </div>
  <div class="astro-carousel__pagination" aria-label={`${label} pagination`}>
    {items.map(({ id, name }, index) => (
      <button
        type="button"
        class:list={['astro-carousel__dot', { 'is-active': index === 0 }]}
        data-carousel-dot
        data-slide={index}
        aria-label={`Show reference from ${name}`}
        aria-controls={id}
        aria-current={index === 0 ? 'true' : undefined}
      ></button>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(carousel => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]')
    if (!track) return

    const slides = Array.from(track.querySelectorAll<HTMLElement>('.astro-carousel__slide'))
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'))
    if (slides.length < 2) return

    const cloneSlide = (slide: HTMLElement) => {
      const clone = slide.cloneNode(true) as HTMLElement
      clone.removeAttribute('id')
      clone.setAttribute('aria-hidden', 'true')
      clone
        .querySelectorAll<HTMLElement>('[tabindex], button')
        .forEach(element => (element.tabIndex = -1))
      return clone
    }
    track.prepend(cloneSlide(slides.at(-1)!))
    track.append(cloneSlide(slides[0]))

    const previous = carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-prev]')
    const next = carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-next]')
    let dragStartX = 0
    let dragStartScrollLeft = 0
    let dragging = false
    let dragSnapTimer: ReturnType<typeof setTimeout> | undefined
    let loopResetTimer: ReturnType<typeof setTimeout> | undefined

    const getPhysicalIndex = () => Math.round(track.scrollLeft / track.clientWidth)
    const getCurrentIndex = () => (getPhysicalIndex() - 1 + slides.length) % slides.length
    const scrollToPhysicalSlide = (index: number, behavior: ScrollBehavior = 'smooth') => {
      track.scrollTo({ left: index * track.clientWidth, behavior })
    }
    const resetLoopPosition = () => {
      const physicalIndex = getPhysicalIndex()
      if (physicalIndex === 0) scrollToPhysicalSlide(slides.length, 'auto')
      if (physicalIndex === slides.length + 1) scrollToPhysicalSlide(1, 'auto')
    }
    const scheduleLoopReset = () => {
      clearTimeout(loopResetTimer)
      loopResetTimer = setTimeout(resetLoopPosition, 400)
    }
    const showSlide = (index: number) => {
      const nextIndex = (index + dots.length) % dots.length
      scrollToPhysicalSlide(nextIndex + 1)
    }
    const updatePagination = () => {
      const currentIndex = getCurrentIndex()
      dots.forEach((dot, index) => {
        const active = index === currentIndex
        dot.classList.toggle('is-active', active)
        dot.setAttribute('aria-current', String(active))
      })
    }

    requestAnimationFrame(() => scrollToPhysicalSlide(1, 'auto'))
    previous.forEach(button =>
      button.addEventListener('click', () => {
        scrollToPhysicalSlide(getPhysicalIndex() - 1)
        scheduleLoopReset()
      })
    )
    next.forEach(button =>
      button.addEventListener('click', () => {
        scrollToPhysicalSlide(getPhysicalIndex() + 1)
        scheduleLoopReset()
      })
    )
    dots.forEach((dot, index) => dot.addEventListener('click', () => showSlide(index)))
    track.addEventListener('scroll', updatePagination, { passive: true })
    track.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault()
        scrollToPhysicalSlide(getPhysicalIndex() + (event.key === 'ArrowLeft' ? -1 : 1))
        scheduleLoopReset()
      }
    })
    track.addEventListener('pointerdown', event => {
      if ((event.target as HTMLElement).closest('button')) return

      clearTimeout(dragSnapTimer)
      dragging = true
      dragStartX = event.clientX
      dragStartScrollLeft = track.scrollLeft
      track.classList.add('is-dragging')
      track.setPointerCapture(event.pointerId)
    })
    track.addEventListener('pointermove', event => {
      if (!dragging) return

      track.scrollLeft = dragStartScrollLeft - (event.clientX - dragStartX)
      event.preventDefault()
    })
    const finishDrag = (event: PointerEvent) => {
      if (!dragging) return

      dragging = false
      if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId)
      scrollToPhysicalSlide(getPhysicalIndex())
      scheduleLoopReset()
      clearTimeout(dragSnapTimer)
      dragSnapTimer = setTimeout(() => track.classList.remove('is-dragging'), 350)
    }
    track.addEventListener('pointerup', finishDrag)
    track.addEventListener('pointercancel', finishDrag)
  })
</script>

<style is:global>
  .astro-carousel {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  .astro-carousel__track {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: pan-y;
    cursor: grab;
  }
  .astro-carousel__track::-webkit-scrollbar {
    display: none;
  }
  .astro-carousel__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .astro-carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    text-align: center;
    padding: 0 20% 80px;
  }
  .astro-carousel__photo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 40px 0;
  }
  .astro-carousel__image {
    border-radius: 50%;
    object-fit: cover;
  }
  .astro-carousel__chevron {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0 9%;
    padding: 0;
    border: 0;
    border-radius: 0;
    appearance: none;
    box-shadow: none;
    background: transparent;
    color: #414141;
    cursor: pointer;
  }
  .astro-carousel__chevron svg {
    width: 14px;
    height: 24px;
  }
  .astro-carousel__chevron path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .astro-carousel__pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .astro-carousel__dot {
    width: 8px;
    height: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    appearance: none;
    box-shadow: none;
    background: #c4c4c4;
    cursor: pointer;
  }
  .astro-carousel__dot.is-active {
    background: #414141;
  }
  .astro-carousel__chevron:focus-visible,
  .astro-carousel__dot:focus-visible {
    outline: 2px solid #414141;
    outline-offset: 3px;
  }

  @media (max-width: 690px) {
    .astro-carousel__slide {
      padding: 0 0 40px;
    }
    .astro-carousel__chevron {
      display: none;
    }
    .astro-carousel__slide .quote {
      width: 100%;
      padding: 0 25px;
    }
  }
</style>
