---
import { Image } from 'astro:assets'
import bicycle from '../../assets/illustrations/hero-bicycle.png'
import jogger from '../../assets/illustrations/hero-jogin.png'
import skateboard from '../../assets/illustrations/hero-skateboard.png'

interface Props {
  alt?: string
  mobile?: boolean
}

const { alt = 'Hero image', mobile = false } = Astro.props
const heroes = [
  { image: bicycle, className: 'heroBicycle', width: 710 },
  { image: jogger, className: 'heroJogin', width: 740 },
  { image: skateboard, className: 'heroSkateboard', width: 710 }
]
const heroWidths = [280, 320, 360, 400, 480, 600, 640, 710, 740, 960, 1080, 1200, 1280, 1420, 1480, 1800]
const heroSizes = (width: number) =>
  mobile
    ? 'min(calc(100vw - 48px), 594px)'
    : `(max-width: 1199px) min(60vw, calc(100vw - 400px)), ${width}px`
---

<div
  class:list={['random-hero', { 'mobile-only': mobile }]}
  data-random-hero
  data-mobile={String(mobile)}
>
  {heroes.map(({ image, className, width }) => (
    <template>
      <Image
        class:list={['hero-image', className, 'random-hero__image']}
        src={image}
        alt={alt}
        {...(mobile ? { height: 510 } : { width })}
        widths={heroWidths}
        sizes={heroSizes(width)}
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </template>
  ))}
  <noscript>
    <Image
      class:list={['hero-image', heroes[0].className, 'random-hero__image']}
      src={heroes[0].image}
      alt={alt}
      {...(mobile ? { height: 510 } : { width: heroes[0].width })}
      widths={heroWidths}
      sizes={heroSizes(heroes[0].width)}
      format="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </noscript>
  <script is:inline>
    ;(() => {
      const hero = document.currentScript.parentElement
      const templates = hero.querySelectorAll('template')
      const page = document.documentElement
      // Both layout positions use the same artwork for this page visit.
      page.dataset.randomHero ??= String(Math.floor(Math.random() * templates.length))
      const selected = templates[Number(page.dataset.randomHero)]
      const mobileViewport = window.matchMedia('(max-width: 690px)')
      const renderHero = () => {
        const active = mobileViewport.matches === (hero.dataset.mobile === 'true')
        const image = hero.querySelector('.random-hero__image')
        if (active && !image) hero.appendChild(selected.content.cloneNode(true))
        if (!active && image) image.remove()
      }

      // Run during HTML parsing rather than waiting for a deferred module.
      renderHero()
      mobileViewport.addEventListener('change', renderHero)
    })()
  </script>
</div>
