---
import ResponsiveImage from '../ui/ResponsiveImage.astro'

interface Props {
  title: string
  subtitle?: string
  image?: any
  imageAlt?: string
  columns?: boolean
}

const { title, subtitle, image, imageAlt = '', columns = false } = Astro.props
---

{columns ? (
  <div class="header">
    <div class="left-col">
      <h1 class="text-center-mobile">{title}</h1>
      {image && (
        <ResponsiveImage
          preset="page-header"
          class="right-header-image mobile-only"
          src={image}
          alt={imageAlt}
          width={504}
          loading="eager"
          fetchpriority="high"
        />
      )}
      {subtitle && <p class="sub2">{subtitle}</p>}
      <slot name="subtitle" />
    </div>
    <div class="hero-right-col center">
      <slot name="right-content">
        {image && (
          <ResponsiveImage
            preset="page-header"
            class="right-header-image"
            src={image}
            alt={imageAlt}
            width={504}
            loading="eager"
            fetchpriority="high"
          />
        )}
      </slot>
    </div>
  </div>
) : (
  <div class="center">
    <h1>{title}</h1>
    {subtitle && <p class="sub2">{subtitle}</p>}
    <slot name="subtitle" />
  </div>
)}
