---
import ResponsiveImage from '../ui/ResponsiveImage.astro'
import ReadMore from '../ui/ReadMore.astro'

interface Props {
  href: string
  title: string
  description: string
  image: any
  imageAlt: string
}

const { href, title, description, image, imageAlt } = Astro.props
---

<a href={href}>
  <div class="row client-details flip clients-details-services">
    <div class="clients-pic mobile-only">
      <div class="service-case-study-image">
        <ResponsiveImage preset="service-project" src={image} alt={imageAlt} width={680} />
      </div>
    </div>
    <div class="our-clients-left-col">
      <div class="left-col align-top">
        <p class="quote">{title}</p>
        <p>{description}</p>
        <ReadMore text="Read full story" />
      </div>
    </div>
    <div class="services-clients-pic">
      <div class="our-clients-pic">
        <div class="right-col clients-pic">
          <div class="service-case-study-image">
            <ResponsiveImage preset="service-project" src={image} alt={imageAlt} width={680} />
          </div>
        </div>
      </div>
    </div>
  </div>
</a>

<style lang="scss">
  @use '../../assets/stylesheets/mixins' as *;

  .our-clients-pic {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    @include mobile-version {
      display: none;
    }

    .clients-pic {
      width: auto;
      padding: 0 20px;
      margin-top: -10px;
      @include tablet-version {
        div {
          max-width: 400px;
        }
      }
      @include desktop-version {
        div {
          max-width: 680px;
        }
      }
    }

    .right-col {
      width: auto;
    }
  }

  .clients-pic {
    &.clients-pic {
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    :global(img) {
      max-width: 100%;
      height: auto;
    }

    @include mobile-version {
      margin-bottom: 48px;
    }
  }

  .our-clients-left-col {
    display: flex;
    flex-direction: column;
    justify-content: center;

    .left-col {
      @include tablet-version {
        width: auto;
      }

      @include desktop-version {
        width: 300px;
      }
    }
  }

  .client-details {
    margin-bottom: 48px;
    justify-content: space-between;
    @include mobile-version {
      margin-bottom: 0px;
    }
    .left-col {
      @include desktop-version {
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        flex-grow: 0;
        align-items: flex-start;

        &.align-top {
          justify-content: flex-start;
        }

        .quote {
          margin-top: 0;
          min-width: 300px;
        }
      }

      @include mobile-version {
        align-items: flex-start;
        text-align: left;
      }
    }

    @include tablet-version {
      padding-bottom: 0px;
    }
  }

  .clients-details-services {
    margin-bottom: 48px;

    @include mobile-version {
      .clients-pic {
        margin-bottom: 5px;
      }
    }

    @include desktop-version {
      width: 800px;
    }
  }

  .service-case-study-image {
    flex: 0 0 680px;
    width: 680px;

    :global(img) {
      height: auto !important;
      width: 680px;
    }

    @include mobile-version {
      flex-basis: auto;
      max-width: 100%;
      width: 100%;

      :global(img) {
        max-width: 100%;
        width: 100%;
      }
    }
  }
</style>
