---
import ResponsiveImage from '../ui/ResponsiveImage.astro'
import ReadMore from '../ui/ReadMore.astro'
import type { LocalImage } from '../../lib/responsive-images'
interface Props {
  href: string
  title: string
  description: string
  readMoreLabel?: string
  layout: 'featured' | 'tile' | 'compact'
  image: LocalImage
  imageAlt: string
}

const {
  href,
  title,
  description,
  readMoreLabel = 'Read full story',
  layout,
  image,
  imageAlt
} = Astro.props
---

<a class:list={['project-card', `project-card--${layout}`]} href={href}>
  <ResponsiveImage
    preset={layout === 'featured' ? 'home-project' : 'project-card'}
    src={image}
    alt={imageAlt}
    class="project-card__image"
    maxWidth={layout === 'featured' ? 600 : layout === 'tile' ? 496 : 180}
    sizes={
      layout === 'featured'
        ? '(max-width: 690px) calc(100vw - 48px), (max-width: 1072px) calc((100vw - 104px) * 0.6), 580.8px'
        : layout === 'tile'
          ? '(max-width: 690px) calc(100vw - 48px), (max-width: 1072px) calc((100vw - 80px) / 2), 496px'
          : '(max-width: 690px) 100px, 180px'
    }
  />
  <div class="project-card__copy">
    <div class="project-card__logo">
      <slot name="logo" />
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <ReadMore text={readMoreLabel} />
  </div>
</a>

<style lang="scss">
  .project-card {
    display: grid;
    gap: 24px;
    min-width: 0;

    &:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 8px;
    }

    .project-card__image {
      display: block;
      width: 100%;
      height: auto;
      align-self: center;
    }

    .project-card__copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      min-width: 0;
    }

    .project-card__logo {
      display: flex;
      align-items: center;
      height: 22px;

      :global(img) {
        width: auto;
        max-width: 100%;
        height: 22px;
        object-fit: contain;
      }
    }

    h3,
    p {
      margin: 0;
      padding: 0;
    }

    :global(.read-more-container) {
      margin: 0;
    }

    &--featured {
      grid-template-columns: 2fr 3fr;
      align-items: center;
      gap: 56px;

      .project-card__image {
        grid-column: 2;
        grid-row: 1;
      }

      .project-card__copy {
        grid-column: 1;
        grid-row: 1;
      }
    }

    &--tile {
      align-content: start;

      .project-card__image {
        aspect-ratio: 496 / 296;
        object-fit: contain;
      }
    }

    &--compact {
      grid-template-columns: 180px 1fr;
      align-items: start;
      gap: 40px;

      .project-card__copy {
        gap: 8px;
      }

      h3 {
        font-size: 24px;
        line-height: 32px;
      }
    }

    @media screen and (max-width: 690px) {
      &--featured {
        grid-template-columns: 1fr;

        .project-card__image,
        .project-card__copy {
          grid-column: auto;
          grid-row: auto;
        }
      }

      &--compact {
        grid-template-columns: 100px 1fr;
        gap: 20px;
      }
    }
  }
</style>
