---

<section class="contact-form know-more">
  <div class="content center">
    <h3 class="small-headline">Still want to know more?</h3>
    <p class="sub2">
      If you share with us your email address, we'll send you a detailed presentation on us:
      <br /> who we are, how we work, what kind of projects we recently delivered, etc.
    </p>
    <div class="know-more narrow-column">
      <form method="post" data-netlify="true" action="/message-sent" name="know_more">
        <input type="hidden" name="form-name" value="know_more" />
        <label for="portfolio-email">Email address</label>
        <div class="row form">
          <input id="portfolio-email" type="text" name="email" data-email-validation />
          <button disabled>I want to know more</button>
        </div>
      </form>
    </div>
    <div class="narrow-column">
      <p class="micro">
        Clicking "I want to know more" you consent to processing your data by
        Brains&nbsp;&amp;&nbsp;Beards&nbsp;sp.&nbsp;zo.o. for marketing purposes, including sending
        emails.
      </p>
    </div>
  </div>
</section>

<script>
  const emailPattern =
    /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/
  document.querySelectorAll<HTMLInputElement>('[data-email-validation]').forEach(input => {
    const form = input.closest('form')
    const button = form?.querySelector<HTMLButtonElement>(
      'button[type="submit"], button:not([type])'
    )
    if (!button) return
    const validate = () => {
      button.disabled = !emailPattern.test(input.value.toLowerCase())
    }
    input.addEventListener('input', validate)
    validate()
  })
</script>
