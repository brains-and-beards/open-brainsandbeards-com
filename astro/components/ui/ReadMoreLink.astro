---
import ReadMore from './ReadMore.astro'

interface Props {
  href: string
  text: string
  class?: string
}

const { href, text, class: className } = Astro.props
---

<a href={href} class:list={['read-more-link', className]}>
  <ReadMore text={text} />
</a>

<style>
  a {
    display: inline-flex;
    max-width: 100%;
  }
  a :global(.read-more-container) {
    justify-content: flex-start;
    margin: 0;
  }
  a :global(.read-more-image) {
    width: 5px;
    height: 10px;
    flex-shrink: 0;
  }
  a :global(.read-more) {
    margin-block: 0;
  }
</style>
