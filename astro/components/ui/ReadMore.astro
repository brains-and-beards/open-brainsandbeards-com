---
import chevron from '../../../src/assets/images/chevron-bold.svg?url'

interface Props {
  text: string
}

const { text } = Astro.props
---

<div class="read-more-container">
  <p class="read-more">
    <span class="inner-text">{text}</span>
  </p>
  <img class="read-more-image" src={chevron} height="10" alt="" aria-hidden="true" />
</div>
