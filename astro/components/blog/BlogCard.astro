---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { formatBlogDate } from '../../lib/blog'
import BlogAuthor from './BlogAuthor.astro'
import ImagePriority from '../ui/ImagePriority.astro'

interface Props {
  post: CollectionEntry<'blog'>
  priorityOnMobile?: boolean
  sizes?: string
}

const {
  post,
  priorityOnMobile = false,
  sizes = '(max-width: 690px) calc(100vw - 128px), 320px'
} = Astro.props
---

<article class="blogpost-preview">
  <a href={post.data.path}>
    <div class="post-container">
      {post.data.image && (
        <Image
          src={post.data.image}
          alt={`Miniature for post: ${post.data.title}`}
          width={320}
          height={200}
          widths={[320, 400, 480, 640, 800, 960, 1280]}
          sizes={sizes}
          format="webp"
          loading="lazy"
        />
      )}
      {post.data.image && priorityOnMobile && <ImagePriority media="(max-width: 690px)" />}
      <p class="quote blog-list-item-title">{post.data.title}</p>
      <h3 class="mobile-only text-center-mobile">{post.data.title}</h3>
    </div>
    <BlogAuthor author={post.data.author} />
    <p class="caption blog-list-item-date">{formatBlogDate(post.data.date)}</p>
  </a>
</article>
