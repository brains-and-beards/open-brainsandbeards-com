---
import { Image } from 'astro:assets'
import { blogAuthors } from '../../lib/blog-authors'

interface Props {
  author?: string
}

const { author } = Astro.props
const details = author ? blogAuthors[author as keyof typeof blogAuthors] : undefined
const teamMember = author?.split(' ')[0]
---

<h3>Want more?</h3>
<p>
  If you liked this post, why don't you subscribe for more content? If you're as old-school as we
  are, you can just grab the <a href="https://brainsandbeards.com/blog/feed.xml">RSS feed</a> of
  this blog. Or enroll to the course described below!
</p>
<p>
  Alternatively, if audio's more your thing why don't you subscribe to{' '}
  <a href="https://podcast.brainsandbeards.com">our podcast</a>! We're still figuring out what it's
  going to be, but already quite a few episodes are waiting for you to check them out.
</p>

{details && teamMember && (
  <a href={`/team#${teamMember}`}>
    <div class="written-by-container">
      <div class="author-container">
        <div class="author-content">
          <Image
            class="circular-image"
            src={details.image}
            alt={`Blog author: ${author}`}
            width={80}
            height={80}
            densities={[1, 2]}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <h5 class="written-by">WRITTEN BY</h5>
          <p class="written-by-author-name">{author}</p>
          <p class="written-by-author-title">{details.title}</p>
        </div>
      </div>
    </div>
  </a>
)}
