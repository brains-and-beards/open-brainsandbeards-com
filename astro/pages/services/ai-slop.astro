---
import MarketingPage from '../../layouts/MarketingPage.astro'
import FeatureList from '../../components/ui/FeatureList.astro'
import CalloutBar from '../../components/ui/CalloutBar.astro'
import hero from '../../assets/illustrations/ai-spaghetti.png'
import codeSpill from '../../assets/illustrations/ai-code-spill.png'
import jenga from '../../assets/illustrations/ai-jenga.png'
import patchwork from '../../assets/illustrations/ai-patchwork.png'

const description =
  "AI tools helped you ship fast. Now every change takes longer than the last. We'll help you untangle the code, so your team can move with confidence again."
---

<MarketingPage
  title="Get your app back under control"
  description={description}
  heroImage={hero}
  heroImageAlt="A robot untangling code from an app window"
  columns
  simpleNavbar
  pageClass="ai-slop-service"
>
  <p slot="header-subtitle" class="sub2">
    You don’t need to throw it all away and start over. We work with the code you already have,
    fixing the parts that slow you down most first, while your team keeps shipping features.
  </p>
  <div class="service-description native-service-description">
    <div class="content narrow-column">
      <h3>Does this sound familiar?</h3>
      <FeatureList
        items={[
          {
            title: 'Code piles up faster than anyone can read it',
            image: codeSpill,
            imageAlt: '',
            paragraphs: [
              'AI assistants can generate thousands of lines in an afternoon. Reviewing them properly takes much longer, so your app ends up with a lot of code that nobody on the team fully understands.'
            ]
          },
          {
            title: 'Every fix breaks something else',
            image: jenga,
            imageAlt: '',
            paragraphs: [
              'Generated code tends to duplicate logic and skip tests. Small changes ripple through the app in unexpected ways, and every release starts to feel risky.'
            ]
          },
          {
            title: 'Nobody knows how it fits together',
            image: patchwork,
            imageAlt: '',
            paragraphs: [
              'Features were stitched together one prompt at a time, without a shared architecture. Onboarding new developers is slow and estimates keep slipping.'
            ]
          }
        ]}
      />
      <h3>How we work</h3>
      <p>
        We start with a short audit. We read the code, run the app and talk to your team, then show
        you where the real risks are and what can safely wait.
      </p>
      <p>
        From there, we clean up step by step, without putting feature work on hold. We add tests
        around the critical flows, refactor duplicated code, and bring the architecture back to
        something your team can reason about.
      </p>
      <p>
        We will also help you set up AI handling practices in order to prevent that mess from
        happening again. We usually do this by applying a combination of smart prompting, extensive
        testing, proper code reviews, and enforcing a set of coding standards - all in order to let
        your team retain control over the codebase without sacrificing the development speed that AI
        tools can provide.
      </p>
    </div>
  </div>
  <CalloutBar title="Let's find out how deep<br/>the mess goes" href="/hire-us/" tonedDown />
  <hr class="content footer-divider" />
</MarketingPage>

<style>
  :global(.ai-slop-service .picture-list img) {
    mix-blend-mode: multiply;
  }
</style>
