---
import PageHeader from '../components/layout/PageHeader.astro'
import CalloutBar from '../components/ui/CalloutBar.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Astro migration preview" noIndex>
  <div slot="header" class="yellow">
    <div class="content row header">
      <PageHeader title="Astro migration preview" subtitle="The shared Astro layout is ready for the first migrated page." />
    </div>
  </div>
  <section class="content">
    <p>This page validates the shared navigation, SEO metadata, global styles, and footer.</p>
  </section>
  <CalloutBar title="Ready for the next migration step?" />
</BaseLayout>
