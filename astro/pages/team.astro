---
import MarketingPage from '../layouts/MarketingPage.astro'
import TeamMemberCard from '../components/interactive/TeamMemberCard.astro'
import TeamHashFocus from '../components/interactive/TeamHashFocus.astro'
import CalloutBar from '../components/ui/CalloutBar.astro'
import patryk from '../../src/assets/team/patryk.jpg'
import wojtek from '../../src/assets/team/wojtek.jpg'
import marek from '../../src/assets/team/marek.jpg'
import szymon from '../../src/assets/team/szymon.jpg'
import lukasz from '../../src/assets/team/lukasz.jpg'
import asia from '../../src/assets/team/asia.jpg'
import marcin from '../../src/assets/team/marcin.jpg'
import piotr from '../../src/assets/team/piotr.jpg'
import david from '../../src/assets/team/david.jpg'
import openPositions from '../../src/assets/team/open-positions.jpg'
import noOutsourcing from '../../src/assets/illustrations/team-no-outsourcing.png?url'
const members: [string, any, string][] = [
  ['Patryk', patryk, 'Ideas machine. Reading too much. Teaching functional mobile and desktop development. I do funny faces on YouTube.'],
  ['Wojciech', wojtek, 'Polyglot software developer. Climber. Interested in renewable energy, electric vehicles, and reforestation.'],
  ['Marek', marek, 'React Native developer with Ruby on Rails backend experience. Ex-chemist. Enjoys climbing and travelling to remote places.'],
  ['Szymon', szymon, 'React Native developer with native Android and iOS experience. Always curious and eager to try new technologies.'],
  ['Łukasz', lukasz, 'React Native developer with web experience. Enthusiast of functional programming and performance gains.'],
  ['Asia', asia, 'React Native developer with web experience. Movie buff and cooking enthusiast.'],
  ['Marcin', marcin, 'A developer who enjoys functional programming, design, and solving complex problems.'],
  ['Piotr', piotr, 'Cheerful and open by nature. Hardworking and goal-oriented; enjoys programming, sports, and gaming.'],
  ['Dávid', david, 'Full-stack product builder focused on turning ideas into useful, well-crafted products.'],
  ['This could be you', openPositions, 'Ready to take the next step in your career? Drop us a message to see if you could join our team.']
]
---
<MarketingPage title="Team" description="Technology is never enough to solve a problem. You'll need a team of experienced and caring developers as well. How about ours?">
  <div class="content-page">
    <div class="big-part-yellow"><div class="content members-box">{members.map(([name, image, bio]) => <TeamMemberCard name={name} image={image} bio={bio} />)}</div></div>
    <TeamHashFocus />
    <div class="narrow-column team-traits text-format">
      <p class="quote center">Above you saw a few words about each of us, but what's important are the qualities we all share.</p>
      <h3>Versatility</h3><p>We build products using iOS, Android, and React Native, valuing both strong native foundations and cross-platform versatility.</p>
      <h3>Reliability</h3><p>Working remotely, we self-manage, recognize priorities, and take ownership of our work.</p>
      <h3>Diversity</h3><p>Different points of view create better products. Our team is spread across Europe and keeps growing.</p>
    </div>
    <div class="contact-form"><div class="content center"><div class="text-left row no-outsourcing"><section><h3>NO OUTSOURCING POLICY</h3><p>We pride ourselves on the quality of our work. To ensure the best results, we never outsource parts of our projects to third parties.</p></section><img src={noOutsourcing} alt="No outsourcing policy" loading="lazy" /></div></div></div>
    <div class="narrow-column center"><h3>Would you like to see us?</h3><p class="sub2">Take a look at our video channels:</p></div>
    <div class="row movies"><div class="column-400 youtube-container"><div class="youtube-wrapper"><iframe src="https://www.youtube.com/embed/udnxfH9me1Q" class="youtube" title="Expectations Management"></iframe></div><a class="sub1" href="https://www.youtube.com/@brains-and-beards-nobrainers">No Brainers</a><p>Curated look at technologies, tools and ideas that improve daily work.</p></div><div class="column-400 youtube-container"><div class="youtube-wrapper"><iframe src="https://www.youtube.com/embed/grR9UmbjpsQ" class="youtube" title="ListView Animations"></iframe></div><a class="sub1" href="https://www.youtube.com/@brains-and-beards">Brain Picks</a><p>Easy solutions to common problems in everyday development.</p></div></div>
  </div>
  <CalloutBar title="Want to work with us?" body="Tell us about your project." />
</MarketingPage>
