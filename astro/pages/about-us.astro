---
import BaseLayout from '../layouts/BaseLayout.astro'
import ResponsiveImage from '../components/ui/ResponsiveImage.astro'
import ReadMoreLink from '../components/ui/ReadMoreLink.astro'
import TeamMemberCard from '../components/interactive/TeamMemberCard.astro'
import { Image } from 'astro:assets'
import { members } from '../lib/team'
import photo from '../assets/photos/patryk-and-wojtek.jpg'
import versatility from '../assets/illustrations/team-versatility-icon.png'
import reliability from '../assets/illustrations/team-reliability-icon.png'
import diversity from '../assets/illustrations/team-diversity-icon.png'
import houseManProgrammer from '../assets/illustrations/team-no-outsourcing.png'
import brains from '../assets/illustrations/about-brains-icon.png'
import beards from '../assets/illustrations/about-beards-icon.png'
import natalia from '../assets/testimonials/team-natalia.jpg'
import type { LocalImage } from '../lib/responsive-images'

const careersImages = Object.values(
  import.meta.glob<{ default: LocalImage }>('../assets/team/you/*.{jpg,jpeg,png,webp,avif}', {
    eager: true
  })
).map(image => image.default)

const traits = [
  {
    title: 'Versatility',
    image: versatility,
    text: 'Native iOS, Android and React Native experience helps us choose the right approach for each product.'
  },
  {
    title: 'Reliability',
    image: reliability,
    text: 'We take ownership, manage our work and focus on the priorities that make a difference.'
  },
  {
    title: 'Diversity',
    image: diversity,
    text: 'Different backgrounds and perspectives help us ask better questions and build better products.'
  }
]
const pillars = [
  {
    title: 'Brains',
    image: brains,
    text: 'Creativity, innovation and a problem solving skills. You give us a challenge, we provide the solution.'
  },
  {
    title: 'Beards',
    image: beards,
    text: 'Experience, perspective and wisdom. We share our knowledge across the whole team.'
  }
]
const channels = [
  {
    title: 'No Brainers',
    video: 'udnxfH9me1Q',
    videoTitle: 'Expectations Management',
    href: 'https://www.youtube.com/@brains-and-beards-nobrainers',
    description:
      'Curated look at new technologies, tools and ideas that will improve your daily work.'
  },
  {
    title: 'Brain Picks',
    video: 'grR9UmbjpsQ',
    videoTitle: 'ListView Animations',
    href: 'https://www.youtube.com/@brains-and-beards',
    description: 'A place where we offer easy solutions to common problems in everyday development.'
  }
]
---

<BaseLayout
  title="About us"
  description="Meet the people behind Brains & Beards. Our story, our team and the thoughtful ways we build better digital products."
>
  <div class="about-page">
    <section class="about-hero">
      <div class="about-container hero-grid">
        <div class="intro">
          <p class="overline">About Brains &amp; Beards</p>
          <h1>
            Great products start
            <br />
            with a great team
          </h1>
          <p class="lead">
            We’re developers, collaborators and curious people. Here’s how we came together and what
            keeps us moving.
          </p>
          <nav class="section-links" aria-label="On this page">
            <ReadMoreLink href="#our-story" text="Our story" />
            <ReadMoreLink href="#our-people" text="Our people" />
            <ReadMoreLink href="#how-we-work" text="How we work" />
          </nav>
        </div>
        <ResponsiveImage
          preset="case-study-hero"
          src={photo}
          alt="Patryk and Wojciech with motorbikes"
          width={520}
          maxWidth={590}
          sizes="(max-width: 760px) calc((100vw - 48px) * 1.134), (max-width: 1000px) calc((100vw - 80px) * 0.604), min(calc((100vw - 112px) * 0.604), 590px)"
          loading="eager"
          fetchpriority="high"
          class="founders-photo"
        />
      </div>
    </section>

    <section class="about-section" id="our-story">
      <div class="about-container story-grid">
        <div class="section-heading">
          <p class="overline">Our story</p>
          <h2>
            Two developers
            <br />
            One shared idea
          </h2>
        </div>
        <div class="story-copy lead">
          <p>
            Patryk and Wojtek met while working at a professional networking company in Germany.
            They wanted more independence and a better way to build digital products.
          </p>
          <p>
            So they started Brains &amp; Beards: a consultancy built around a great team, thoughtful
            workflows and the freedom to keep improving. Today, that same idea brings all of us
            together.
          </p>
        </div>
      </div>
    </section>

    <section class="about-section" id="our-people">
      <div class="about-container section-stack">
        <p class="overline">Our people</p>
        <h2>The people behind the work</h2>
        <p class="lead">
          Different backgrounds. Shared curiosity. A team that already works well together.
        </p>
        <div class="people-grid" id="Brains&Beards">
          {members.map(([name, image, bio]) => (
            <TeamMemberCard name={name} image={image} bio={bio} />
          ))}
          <TeamMemberCard
            name="This could be you"
            bio="Ready to take the next step in your career? Drop us a message to see if you could join our team."
            image={careersImages[0]}
            randomImages={careersImages}
            careers
          />
        </div>
      </div>
    </section>

    <section class="about-section" id="how-we-work">
      <div class="about-container section-stack">
        <p class="overline">How we work</p>
        <h2>Thoughtful ways of working</h2>
        <p class="lead">
          We invest in our team, share what we learn and keep improving the way we build.
        </p>
        <div class="three-columns traits">
          {traits.map(({ title, image, text }) => (
            <div class="trait">
              <Image
                src={image}
                alt=""
                width={88}
                height={88}
                densities={[1, 2]}
                format="webp"
                loading="lazy"
              />
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cream compact-section">
      <div class="about-container outsourcing-content">
        <div>
          <h2>No outsourcing policy</h2>
          <br />
          <p>
            We pride ourselves on the quality of our work and it's our top priority to ensure you
            get the best results. For this reason, we never outsource any parts of our projects to
            3rd parties.
          </p>
          <br />
          <p>The team you meet is the team you work with.</p>
        </div>
        <Image
          src={houseManProgrammer}
          alt=""
          width={240}
          height={240}
          densities={[1, 2]}
          format="webp"
          loading="lazy"
        />
      </div>
    </section>

    <section class="name-section compact-section">
      <div class="about-container name-grid">
        <div class="name-story">
          <p class="overline">Our name</p>
          <h2>
            Curiosity meets
            <br />
            experience
          </h2>
          <p class="lead">
            Brains for creative problem-solving. Beards for the knowledge that comes from
            experience. Both shape the way we work.
          </p>
        </div>
        <div class="pillars">
          {pillars.map(({ title, image, text }) => (
            <div class="pillar">
              <Image
                src={image}
                alt=""
                width={160}
                height={160}
                densities={[1, 2]}
                format="webp"
                loading="lazy"
              />
              <div class="pillar-copy">
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cream compact-section testimonial-section" aria-label="Life on the team">
      <div class="about-container">
        <div class="testimonial-divider"></div>
        <figure class="team-quote">
          <Image
            src={natalia}
            alt="Natalia Majkowska-Stewart"
            width={100}
            height={100}
            densities={[1, 2]}
            format="webp"
            loading="lazy"
          />
          <div>
            <blockquote>
              “It was a pleasure working at Brains &amp; Beards - a company where everyone is
              treated equally, fairly, and without discrimination. There was always time to develop
              yourself. I developed amazingly working with everyone on the team and gained valuable
              experience as a remote software engineer. In addition, my colleagues were always
              approachable and I'd always be eager to start a new working day.”
            </blockquote>
            <figcaption>
              Natalia Majkowska-Stewart · React Native Developer, former Brains &amp; Beards
            </figcaption>
          </div>
        </figure>
      </div>
    </section>

    <section class="compact-section">
      <div class="about-container section-stack">
        <p class="overline">Beyond the bio</p>
        <h2>Get to know us a little better</h2>
        <p class="lead">We share what we learn through No Brainers and Brain Picks.</p>
        <div class="video-grid">
          {channels.map(({ title, video, videoTitle, href, description }) => (
            <article class="video-card">
              <div class="video-embed">
                <iframe
                  src={`https://www.youtube.com/embed/${video}`}
                  title={videoTitle}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
              <h3>
                <a href={href}>{title}</a>
              </h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-cta compact-section">
      <div class="about-container cta-grid">
        <div>
          <h2>Let’s build something together</h2>
          <p class="lead">
            Tell us what you have in mind. We’ll bring the curiosity and experience.
          </p>
        </div>
        <div class="contact-actions">
          <div class="button">
            <a href="/hire-us/">Get in touch</a>
          </div>
          <ReadMoreLink
            href="mailto:smile@brainsandbeards.com?subject=Let's%20build%20something%20together"
            text="Prefer an introduction? Send us an email"
          />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style lang="scss">
  @use '../assets/stylesheets/colors' as *;
  @media (min-width: 761px) {
    :global(body:has(.about-page) .menu-container) {
      padding-block: 28px;
    }
  }
  .about-page {
    background: $lightGrey;
  }
  .about-page :is(h1, h2, h3, p, figure, blockquote) {
    margin: 0;
  }
  .about-page h1,
  .about-page h2 {
    font-size: 40px;
    line-height: 48px;
  }
  .about-page h3 {
    padding: 0;
    font: 24px/32px 'Neutrif Medium';
  }
  .about-container {
    max-width: 1040px;
    margin-inline: auto;
    width: calc(100% - 48px);
  }
  .about-hero,
  .about-cta {
    background: $yellow;
  }
  .about-hero {
    padding-block: 64px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 456fr) minmax(0, 520fr);
    gap: 64px;
    align-items: start;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .overline {
    font: 12px/24px 'Neutrif Medium';
    text-transform: uppercase;
  }
  .lead {
    font-size: 18px;
    line-height: 32px;
  }
  .section-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 36px;
    font-family: 'Neutrif Medium';
  }
  .about-page a:not(.button a, .read-more-link):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .about-page :global(.founders-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 520 / 340;
    object-fit: cover;
  }
  .about-section {
    padding-block: 80px;
    scroll-margin-top: 24px;
  }
  .compact-section {
    padding-block: 64px;
  }
  .story-grid {
    display: grid;
    grid-template-columns: 320fr 656fr;
    gap: 64px;
  }
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .story-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .section-stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .people-grid,
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 40px;
  }
  .three-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  #how-we-work,
  .name-section {
    background: white;
  }
  .outsourcing-content {
    position: relative;
    padding-right: 288px;
    min-height: 112px;
  }
  .outsourcing-content h2 {
    font-family: 'Recoleta';
    margin-bottom: 16px;
  }
  .outsourcing-content .outsourcing-subtitle {
    font: 18px/28px 'Neutrif Medium';
    margin-bottom: 8px;
  }
  .outsourcing-content img {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    width: 240px;
    height: 240px;
    object-fit: contain;
  }
  .trait {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    align-items: center;
    gap: 20px 16px;
    padding-left: 16px;
  }
  .trait img {
    display: block;
    object-fit: contain;
  }
  .trait p {
    grid-column: 1 / -1;
    align-self: start;
  }
  .trait p,
  .pillar p {
    font-size: 18px;
    line-height: 24px;
  }
  .cream {
    background: $paleYellow;
  }
  .name-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-items: center;
    gap: 40px;
  }
  .pillars {
    display: grid;
    gap: 24px;
    margin-left: 24px;
  }
  .name-story {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .pillar {
    display: grid;
    grid-template-columns: minmax(0, 160px) auto;
    align-items: center;
    align-self: center;
    gap: 16px;
  }
  .pillar img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .pillar-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .testimonial-section {
    padding-top: 0;
  }
  .testimonial-divider {
    border-top: 1px solid #d8d5c3;
    margin-bottom: 64px;
  }
  .team-quote {
    display: flex;
    align-items: start;
    gap: 48px;
  }
  .team-quote img {
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
  }
  .team-quote blockquote {
    font: 24px/40px 'Recoleta';
    color: $black;
    border: 0;
    padding: 0;
  }
  figcaption {
    margin-top: 20px;
    font-size: 14px;
    line-height: 24px;
  }
  .video-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .video-embed {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 16 / 9;
  }
  .video-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .cta-grid {
    display: grid;
    grid-template-columns: minmax(0, 640fr) minmax(0, 336fr);
    gap: 64px;
  }
  .cta-grid h2 {
    margin-bottom: 16px;
  }
  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 20px;
  }
  .contact-actions .button {
    margin: 0;
    padding: 0;
    background: $black;
    border-radius: 8px;
    color: white;
  }
  .contact-actions .button a {
    display: inline-block;
    padding: 16px 30px;
    font-size: 18px;
    line-height: 24px;
  }
  @media (max-width: 1000px) {
    .hero-grid,
    .story-grid,
    .cta-grid {
      gap: 32px;
    }
    .three-columns,
    .name-grid {
      gap: 24px;
    }
  }
  @media (max-width: 760px) {
    .about-hero,
    .about-section,
    .compact-section {
      padding-block: 48px;
    }
    .hero-grid,
    .story-grid,
    .people-grid,
    .three-columns,
    .name-grid,
    .video-grid,
    .cta-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .outsourcing-content {
      padding-right: 0;
      padding-top: 88px;
    }
    .outsourcing-content img {
      top: -72px;
      right: 50%;
      transform: translateX(50%);
      width: 144px;
      height: 144px;
    }
    .about-page h1,
    .about-page h2 {
      font-size: 32px;
      line-height: 40px;
    }
    .about-page h1 br {
      display: none;
    }
    .section-stack,
    .intro {
      gap: 24px;
    }
    .trait {
      padding-left: 0;
    }
    .pillars {
      margin-left: 0;
    }
    .pillar {
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 20px 16px;
    }
    .pillar-copy {
      display: contents;
    }
    .pillar p {
      grid-column: 1 / -1;
    }
    .team-quote {
      flex-direction: column;
      gap: 24px;
    }
    .team-quote blockquote {
      font-size: 20px;
      line-height: 32px;
    }
    .testimonial-section {
      padding-top: 0;
    }
    .testimonial-divider {
      margin-bottom: 48px;
    }
    .video-embed {
      max-width: none;
    }
  }
</style>
