---
import MarketingPage from './MarketingPage.astro'
import CalloutBar from '../components/ui/CalloutBar.astro'
import ResponsiveImage from '../components/ui/ResponsiveImage.astro'
import TrustBar, { type TrustItem } from '../components/ui/TrustBar.astro'
interface Props {
  title: string
  description: string
  hero?: any
  heroAlt?: string
  trustBar?: boolean
  trustItems?: TrustItem[]
}
const { title, description, hero, heroAlt = '', trustBar = false, trustItems } = Astro.props
---

<MarketingPage title={title} description={description} simpleNavbar projects>
  <article id="case-study" class="text-format">
    {hero && (
      <div class="big-part-yellow">
        <ResponsiveImage
          preset="case-study-hero"
          src={hero}
          class="heading-pic"
          alt={heroAlt}
          width={1024}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}
    <slot />
  </article>
  {trustBar && <TrustBar trustItems={trustItems} />}
  <CalloutBar title="Let us craft a custom solution<br/>for your product" />
</MarketingPage>
