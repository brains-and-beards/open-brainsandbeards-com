---
import ResponsiveImage from '../components/ui/ResponsiveImage.astro'
import type { CollectionEntry } from 'astro:content'
import CourseEnrollBanner from '../components/blog/CourseEnrollBanner.astro'
import BlogPostFootnote from '../components/blog/BlogPostFootnote.astro'
import RelatedStories from '../components/blog/RelatedStories.astro'
import MarketingPage from './MarketingPage.astro'
import { formatBlogDate, getBlogPosts } from '../lib/blog'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const heroMaxWidth = post.data.image
  ? Math.min(984, (700 * post.data.image.width) / post.data.image.height)
  : 984
---

<MarketingPage
  title={post.data.title}
  description={post.data.title}
  headerSubtitle={formatBlogDate(post.data.date)}
>
  <article class="blog-body line-numbers">
    {post.data.image && (
      <div class="top-part-yellow">
        <div class="content">
          <ResponsiveImage
            preset="blog-hero"
            class="main-blog-image"
            style={`--blog-hero-max-width: ${heroMaxWidth}px`}
            src={post.data.image}
            alt={post.data.imageCaption || post.data.title}
            width={1024}
            sizes={`(max-width: 690px) min(calc(100vw - 40px), 1024px), min(calc(100vw - 40px), ${heroMaxWidth}px)`}
            loading="eager"
            fetchpriority="high"
          />
          {post.data.imageCaption && (
            <figcaption class="main-blog-image-caption" set:html={post.data.imageCaption} />
          )}
        </div>
      </div>
    )}
    <div class="narrow-column">
      <slot />
      <BlogPostFootnote author={post.data.author} />
    </div>
  </article>
  <CourseEnrollBanner />
  <RelatedStories post={post} posts={await getBlogPosts()} />
</MarketingPage>
